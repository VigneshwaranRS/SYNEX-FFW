# SYNEX Environment Variables
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local or real credentials to Git.

# ─── Supabase (public values — safe to expose in frontend) ───────────────────
# Found in: Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Supabase service role (SERVER-SIDE ONLY — Edge Functions) ────────────────
# This key MUST NOT start with VITE_ and MUST NOT be placed in any frontend code.
# Place it ONLY in your Edge Function secrets or Vercel environment (server only).
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here  ← DO NOT PUT HERE

# ─── Deployment ───────────────────────────────────────────────────────────────
# VITE_PUBLIC_URL=https://your-deployed-url.vercel.app
